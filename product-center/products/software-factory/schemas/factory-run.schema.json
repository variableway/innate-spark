{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yorun.ai/schemas/factory-run.schema.json",
  "title": "FactoryRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pack_id", "pipeline", "created_at", "updated_at", "stages", "verdict"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "pipeline": { "enum": ["A", "B"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "dsh_session_id": { "type": "string" },
    "verdict": {
      "enum": ["running", "blocked", "ready_for_handoff", "signed", "cancelled"]
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string" },
        "status": {
          "enum": ["queued", "running", "needs_review", "passed", "blocked", "skipped", "cancelled"]
        },
        "reason": {
          "enum": ["schema", "human", "worker", "runner", "interrupted"]
        },
        "worker_session_id": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skel_frozen": { "type": "boolean" },
            "acked_by": { "type": "string" },
            "acked_at": { "type": "string" }
          }
        },
        "last_runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "exit_code": { "type": "integer" },
            "started_at": { "type": "string" },
            "finished_at": { "type": "string" }
          }
        }
      }
    }
  }
}
